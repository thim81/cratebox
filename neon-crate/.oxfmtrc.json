{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    ".output",
    ".vinxi",
    "routeTree.gen.ts",
    "pnpm-lock.yaml",
    "package-lock.json",
    "bun.lock"
  ]
}
